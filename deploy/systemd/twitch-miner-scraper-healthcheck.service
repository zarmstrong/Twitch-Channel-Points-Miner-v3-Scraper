[Unit]
Description=Check Twitch Miner scraper health and ping Healthchecks
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=scraper
Group=scraper
EnvironmentFile=/etc/twitch-miner-scraper/healthcheck.env
ExecStart=/usr/local/libexec/check-twitch-miner-scraper-health
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
