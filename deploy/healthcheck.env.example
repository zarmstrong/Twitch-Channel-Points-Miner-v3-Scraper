# Keep the real Healthchecks URL outside source control.
TCPMS_HEALTHCHECKS_URL=https://hc-ping.com/replace-with-check-uuid

# The health-check runner must be able to read this file. When it runs outside
# the scraper container, mount the scraper data volume at this path read-only.
TCPMS_MONITOR_FILE=/data/scraper-monitor.json

# Keep these synchronized with the scraper schedule when overriding defaults.
TCPMS_DROPS_INTERVAL_SECONDS=900
TCPMS_BADGES_INTERVAL_SECONDS=1200
TCPMS_HEALTH_GRACE_SECONDS=300
TCPMS_HEALTHCHECKS_TIMEOUT_SECONDS=10
TCPMS_HEALTH_REQUIRE_UPLOAD=true
